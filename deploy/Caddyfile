# Gateway vor der Website (Charakterbogen-Uebersetzer). Origin von dnd.magnetron.me; der
# web-tunnel-Connector erreicht ihn im Netz web-edge.
#
# Seit dem 26.08.2026 steht hier KEINE MCP-Route mehr. Der MCP haengt am geteilten Router
# (mcp.magnetron.me/<token>/foliant/mcp) und ist auf dieser Domain absichtlich nicht mehr
# erreichbar: ein Eingang, ein Geheimnis, eine Stelle, die stimmen muss. `foliant-mcp`
# liegt ausserdem nur noch im Netz `mcp-net` - dieser Container koennte ihn gar nicht
# mehr erreichen, selbst wenn hier eine Regel stuende.
#
# Access-Logs bleiben trotzdem aus: Es gibt keinen Grund, die Aufrufe der Runde
# mitzuschreiben, und die Kennwort-Seite traegt Formularfelder.

{
	admin off
	auto_https off
	log {
		output discard
	}
}

:8080 {
	log {
		output discard
	}

	# Alles -> Website. Den Zugangsschutz macht die Website SELBST (eine Kennwort-Seite,
	# EIN Kennwort ohne Benutzernamen - Eigentuemer-Wunsch; HTTP-Basic-Auth erzwingt im
	# Browser immer ein Benutzerfeld). Ohne WEB_PASSWORT ist sie zu (fail-closed). Der
	# Gateway proxyt nur. Ihr /health traegt das externe Uptime-Monitoring auf dieser
	# Domain; die Verfuegbarkeit des MCP beantwortet jetzt der Router (dessen /health).
	handle {
		reverse_proxy web:8080
	}
}
