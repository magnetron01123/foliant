# Foliant - Umgebungsvariablen. Kopieren nach .env (gitignored). KEINE echten Werte committen.

# --- Administration vom Mac aus (nur dort noetig, nicht auf dem Pi) ----------
# SSH-Ziel des Pi, z. B. pi@raspberrypi.local oder pi@192.168.1.x. EINMAL hier eintragen,
# dann finden `make deploy-pi`, `make test-golden-pi`, `make lasttest-pi` und
# `make eval-verhalten-pi` es von allein - sonst muss es bei JEDEM Aufruf mitgegeben
# werden (PI=...), und genau das wurde vergessen.
# Warum hier und nicht in der Doku: das Repository ist oeffentlich, und die
# betreiberspezifischen Angaben sind bei der Veroeffentlichung bewusst anonymisiert
# worden (BACKLOG.md §5). Ein LAN-Hostname gehoert dorthin nicht.
PI=

# Cloudflare Named Tunnel Token (aus dem Zero-Trust-Dashboard):
CLOUDFLARE_TUNNEL_TOKEN=

# HINWEIS: Das DDB-Cobalt-Secret gehoert NICHT hierher. Der DDB-Exporter fragt es zur
# Laufzeit verdeckt ueber die TTY ab (nie .env, argv, Compose-Environment oder Logs) -
# siehe CONCEPT.md §10 (ADR). Auf dem Pi liegt es kurzzeitig als Datei; deren Pfad:
FOLIANT_COBALT_DATEI=/run/secrets/ddb_cobalt

# Produktionsmodus: erzwingt beim Start ein FOLIANT_PFAD_TOKEN von mindestens 16 Zeichen
# (fail-fast statt fail-open). Auf dem Pi PFLICHT, lokal leer lassen.
FOLIANT_PRODUKTION=

# Zugang (M3, app/zugriff.py): Geheimpfad-Token - der MCP-Endpoint liegt dann unter
# https://<host>/<token>/mcp (die URL ist der Schluessel). Erzeugen:
#   python3 -c "import secrets; print(secrets.token_urlsafe(18))"
# Rotation bei Leak: neuen Wert setzen, `docker compose up -d --build foliant`, neue URL teilen.
FOLIANT_PFAD_TOKEN=

# IP-Allowlist (Anthropic-Egress, an/aus - 'aus' nur zum Debuggen):
FOLIANT_IP_FILTER=an
# Optionale Zusatz-CIDRs (kommagetrennt), z. B. Heim-IP fuer Direkt-Tests oder Uptime-Monitor:
FOLIANT_ERLAUBTE_IPS=

# --- Charakterbogen-Uebersetzer (app/charakterbogen) ---
# WICHTIG: Das ist ein ANTHROPIC-API-Schluessel aus der Konsole (console.anthropic.com,
# eigene nutzungsbasierte Abrechnung) - NICHT das Claude-/Claude-Code-Abo. Ohne diese Werte
# laeuft alles ausser dem echten Freitext-Uebersetzungslauf; POST /bogen meldet dann
# "Uebersetzung momentan nicht verfuegbar". Nie echte Werte committen.
ANTHROPIC_API_KEY=
# Modell-ID (nicht hart kodiert). Empfehlung Uebersetzung: claude-sonnet-5 (Qualitaet/Kosten),
# guenstiger: claude-haiku-4-5-20251001; hoechste Qualitaet: claude-opus-4-8.
ANTHROPIC_MODEL=

# --- Charakterbogen-Website: Zugang -----------------------------------------
# EIN Kennwort, kein Benutzername. Frei waehlbar, einfach hier eintragen (kein Hash noetig).
# Fehlt es, ist die Website zu (fail-closed) - nie versehentlich offen im Netz.
WEB_PASSWORT=

# --- Website: "Foliant im Claude-Chat"-Abschnitt (MCP-Link, nur hinter dem Login) ---
# Normalerweise NICHTS zu tun: web.py baut den Link aus FOLIANT_BASIS_URL + dem
# FOLIANT_PFAD_TOKEN (oben) zusammen. Nur setzen, wenn der angezeigte Link davon
# abweichen soll (z. B. andere Domain):
FOLIANT_BASIS_URL=https://dnd.magnetron.me
FOLIANT_MCP_URL=

# --- Discord-Bot (Dienst 'discord'; Einrichtung: CONCEPT.md §8) --------------
# Bot-Token aus dem Discord-Entwicklerportal (Bot -> Reset Token). Geheim wie ein
# Passwort - nur hier, nie in Compose/Logs/Repo.
DISCORD_BOT_TOKEN=
# Die EINE erlaubte Server-ID (Rechtsklick auf den Server -> "Server-ID kopieren";
# Entwicklermodus noetig). Ohne sie startet der Bot nicht: der Bestand ist privat
# fuer die Runde (SPEC.md §12), die Guild-Sperre ist die Zugangskontrolle.
DISCORD_GUILD_ID=
# Optional: nur diese Kanal-IDs bedienen (kommagetrennt); leer = alle Kanaele.
DISCORD_KANAL_IDS=
# Kostendeckel: Fragen pro UTC-Tag ueber alle Nutzer (Default 100).
DISCORD_TAGESDECKEL=

# --- Nur fuer den Betrieb ausserhalb von docker compose ---------------------
# Im Compose-Betrieb sind diese beiden Pfade bereits gesetzt; nur noetig, wenn der
# Web-Dienst ohne Compose laeuft (z. B. lokal auf Port 8099):
CHARAKTERBOGEN_GLOSSAR=
CHARAKTERBOGEN_VORLAGE=
